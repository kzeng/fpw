{
  "schemaVersion": 1,
  "name": "postbuild-nvr-inject",
  "description": "Generate NVR from XLSM and inject it into both MCU image banks.",
  "steps": [
    {
      "id": "read_image",
      "kind": "image-input",
      "name": "mcu_image",
      "path": "../Postbuild/Input/GungnirS_gboot.hex"
    },
    {
      "id": "generate_nvr",
      "kind": "nvr-generate",
      "output": "nvr_block",
      "workbook": "../Postbuild/default_nvr/22339878-001_000_DR8_1600T_SIAN3_NVR_cfg_v0.9_sipho_default.xlsm",
      "page": 254,
      "bankStart": 8,
      "bankEnd": 9,
      "registerStart": 128,
      "registerEnd": 255,
      "baseAddress": "0x08002000",
      "ignoreMaskRule": false,
      "alternateBase": true,
      "sheets": [
        { "name": "8_254_Low", "bank": 8, "rowStart": 4, "rowEnd": 230, "dataColumn": 7 },
        { "name": "9_254_Pg00", "bank": 9, "rowStart": 3, "rowEnd": 140, "dataColumn": 7 }
      ]
    },
    {
      "id": "inject_nvr",
      "kind": "nvr-inject-image",
      "image": "mcu_image",
      "nvr": "nvr_block",
      "output": "mcu_with_nvr",
      "mirrorOffset": "0x100000"
    },
    {
      "id": "write_hex",
      "kind": "image-output",
      "input": "mcu_with_nvr",
      "name": "nvr_hex",
      "path": "../target/nvr-imgar/gboot-with-nvr.hex",
      "recordSize": 16
    }
  ]
}
