{
  "schemaVersion": 1,
  "name": "postbuild-nvr-archive",
  "description": "Append a generated NVR-REG block to an existing imgAr archive.",
  "steps": [
    {
      "id": "read_archive",
      "kind": "input",
      "name": "archive",
      "path": "../target/nvr-imgar/base.bin"
    },
    {
      "id": "generate_nvr",
      "kind": "nvr-generate",
      "output": "nvr_block",
      "workbook": "../workflows/default_nvr/config.xlsm",
      "page": 254,
      "bankStart": 0,
      "bankEnd": 0,
      "registerStart": 128,
      "registerEnd": 255,
      "baseAddress": "0x08002000",
      "ignoreMaskRule": false,
      "alternateBase": false,
      "sheets": [
        { "name": "0_254", "bank": 0, "rowStart": 3, "rowEnd": 146, "dataColumn": 7 }
      ]
    },
    {
      "id": "append_nvr",
      "kind": "nvr-append-archive",
      "archive": "archive",
      "nvr": "nvr_block",
      "output": "archive_with_nvr",
      "tool": "../tools/imgAr.exe",
      "encryption": "enc0"
    },
    {
      "id": "write_archive",
      "kind": "output",
      "input": "archive_with_nvr",
      "name": "release_archive",
      "path": "../target/nvr-imgar/release-with-nvr.bin"
    }
  ]
}
